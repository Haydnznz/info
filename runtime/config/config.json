{
  "system": {
    "name": "舆情分析平台",
    "port": 9000
  },
  "apps": {
    "topic_search": {
      "enabled": true
    },
    "multimedia_search": {
      "enabled": true
    },
    "insight_analysis": {
      "enabled": true
    },
    "report_generator": {
      "enabled": true
    }
  },
  "collection": {
    "keywords": [
      "人工智能"
    ],
    "interval_seconds": 5
  },
  "runtime": {
    "demo_mode": true
  },
  "cluster": {
    "role": "coordinator",
    "worker_lease_seconds": 30,
    "max_attempts": 3,
    "worker_token_env": "OPINION_WORKER_TOKEN"
  }
}