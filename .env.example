# Coordinator / Worker shared secret
OPINION_WORKER_TOKEN=replace-with-a-long-random-secret
# Public API authentication. Set a long random AUTH_SECRET in deployments.
AUTH_ENABLED=true
AUTH_SECRET=replace-with-a-long-random-auth-secret
AUTH_TOKEN_TTL_SECONDS=28800
AUTH_PASSWORD_RESET_TOKEN=replace-with-a-separate-password-reset-token
AUTH_ADMIN_USERNAME=admin
AUTH_ADMIN_PASSWORD=change-me-admin
AUTH_OPERATOR_USERNAME=operator
AUTH_OPERATOR_PASSWORD=change-me-operator
AUTH_VIEWER_USERNAME=viewer
AUTH_VIEWER_PASSWORD=change-me-viewer
# Optional JSON user list; each item requires username, password and role.
# AUTH_USERS_JSON=[{"username":"alice","password":"...","role":"operator"}]
# Coordinator data root; defaults to the project directory
OPINION_DATA_DIR=.
# Optional API bind settings
OPINION_API_HOST=127.0.0.1
OPINION_API_PORT=9000
# Volcengine Ark / Doubao networked search. Keep the secret out of config files.
VOLCENGINE_API_KEY=replace-with-your-volcengine-api-key
VOLCENGINE_SEARCH_MODEL=replace-with-your-endpoint-model
VOLCENGINE_SEARCH_ENDPOINT=https://ark.cn-beijing.volces.com/api/v3/responses
ASK_ECHO_SEARCH_INFINITY_API_KEY=replace-with-your-askecho-search-api-key
VOLCENGINE_ACCESS_KEY=
VOLCENGINE_SECRET_KEY=
MCP_SEARCH_MODE=stdio
MCP_UV_COMMAND=uv
MCP_SERVER_CWD=C:\\path\\to\\mcp-server\\server\\mcp_server_askecho_search_infinity
MCP_UV_CACHE_DIR=runtime/uv-cache
MCP_SEARCH_URL=
MCP_SEARCH_TRANSPORT=sse
MCP_SEARCH_TOOL=
GDELT_API_URL=https://api.gdeltproject.org/api/v2/doc/doc
FORUM_RSS_URLS=
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
YOUTUBE_API_KEY=replace-with-your-youtube-api-key
YOUTUBE_API_URL=https://www.googleapis.com/youtube/v3/search
YOUTUBE_WATCH_URL_TEMPLATE=https://www.youtube.com/watch?v={video_id}
OPINION_HTTP_USER_AGENT=OpinionAnalysisPlatform/0.2
OPINION_HTTP_TIMEOUT=15
OPINION_COORDINATOR_URL=http://127.0.0.1:9000
MONGO_URL=mongodb://192.168.10.129:27017
MONGO_DB_NAME=info001
MONGO_ENABLED=true
MONGO_SOURCES_COLLECTION=input_sources
MONGO_RUNS_COLLECTION=input_runs
MONGO_TIMEOUT_MS=3000
GDELT_ENABLED=false
WIKIMEDIA_ENABLED=false
# Local BGE-M3 and Milvus
BGE_M3_PATH=D:\\AI learn\\掌柜智库\\models\\BAAI\\bge-m3
BGE_M3=BAAI/bge-m3
BGE_DEVICE=cuda:0
BGE_FP16=True
MILVUS_ENABLED=true
MILVUS_URL=http://127.0.0.1:19530
MILVUS_URI=http://127.0.0.1:19530
MILVUS_HOST=127.0.0.1
MILVUS_PORT=19530
MILVUS_USER=
MILVUS_PASSWORD=
MILVUS_TOKEN=
MILVUS_DB_NAME=default
MILVUS_COLLECTION=info
MILVUS_DIMENSION=1024
MILVUS_TIMEOUT=3
# Optional LangGraph LLM insight
LLM_ENABLED=false
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini
